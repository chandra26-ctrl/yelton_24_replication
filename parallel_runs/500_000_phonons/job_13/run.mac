#-----------------------------------------------
# quasiparticle_resonator_targeted.mac
#
# Visualize pair-breaking phonons launched beneath one of the
# six 10 um by 10 um Al junction-electrode patches.
#------------------------------------------

# Initialize the run
/run/initialize

# We'll use an OpenGL viewer here, and load
# a specific angle and zoom
#/vis/open OGL
#/vis/viewer/set/upVector 0 1 0
#/vis/viewer/set/viewpointThetaPhi 0 180
#/vis/viewer/zoom 80
#/vis/drawVolume

/run/printProgress 1

# for drawing the tracks
/tracking/verbose 0
/tracking/storeTrajectory 0
#/vis/scene/endOfEventAction accumulate
#/vis/scene/add/trajectories

# Trajectory coloring by particle type
#/vis/modeling/trajectories/create/drawByParticleID
#/vis/modeling/trajectories/drawByParticleID-0/set phononTS Green 
#/vis/modeling/trajectories/drawByParticleID-0/set phononTF Green
#/vis/modeling/trajectories/drawByParticleID-0/set phononL Green
#/vis/modeling/trajectories/drawByParticleID-0/set BogoliubovQP White

# Trajectory filtering by particle type
#/vis/filtering/trajectories/create/particleFilter
#/vis/filtering/trajectories/particleFilter-0/add phononTS
#/vis/filtering/trajectories/particleFilter-0/add phononTF
#/vis/filtering/trajectories/particleFilter-0/add phononL
#/vis/filtering/trajectories/particleFilter-0/add BogoliubovQP

# Toggle phononBounces depending on whether
# you want to see a full event or not.
/g4cmp/phononBounces 1000000
/g4cmp/qpBounces 5
/g4cmp/minEPhonons 0.000382 eV

#/process/inactivate phononScattering
#/process/inactivate phononDownconversion
/process/inactivate phononPolycrystalElasticScattering #TODO: check if needed
/process/inactivate qpRecombination # TODO: MAKE INACTIVE
#/process/inactivate qpRadiatesPhonon
#/process/inactivate scPairBreaking
/process/inactivate qpDiffusion  # TODO: MAKE INACTIVE
#/process/inactivate qpLocalTrapping 
#/process/inactivate qpDiffusionTimeStepper

# Generate phonons just inside the silicon beneath the lower-right Al patch.
# This patch retains the center of the former lower-right resonator assembly:
# (x,y) = (1.7463095, -0.9746555) mm.  The silicon top is z=5.0001 mm.
/gps/number 1
/gps/particle phononTF
/gps/pos/type Point
#/gps/pos/centre 1.7463095 -0.9746555 5.00009 mm
#/gps/pos/centre 2.5 -1.5 5.00009 mm
/gps/pos/centre 2.5 -0.9746555 5.00009 mm

/random/setSeeds 123469 568111

# Launch 2*Delta_Al phonons into the silicon (-z hemisphere).
/gps/ang/type iso
/gps/ang/mintheta 90 deg
/gps/ang/maxtheta 180 deg
/gps/ene/type Mono
/gps/energy 0.000382 eV
/gps/number 31250
/run/beamOn 1
